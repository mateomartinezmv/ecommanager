{%- liquid
  assign pct = 10
  if settings.precio_contado_pct != blank
    assign pct = settings.precio_contado_pct
  endif

  assign codigo = 'CONTADO10'
  if settings.precio_contado_codigo != blank
    assign codigo = settings.precio_contado_codigo
  endif

  assign attr_key = 'Forma de pago'
  assign val_contado = 'Transferencia o efectivo'
  assign val_tarjeta = 'Tarjeta o cuotas'

  assign quiere_contado = false
  if cart.attributes[attr_key] == val_contado
    assign quiere_contado = true
  endif

  assign base = cart.original_total_price
  assign aplicado = false
  if cart.total_price < base
    assign aplicado = true
  endif

  assign factor = 100 | minus: pct
  assign contado = base | times: factor | divided_by: 100 | floor
  assign ahorro = base | minus: contado

  # Un name distinto por instancia: el drawer esta en el DOM de todas las paginas,
  # asi que en /cart conviven dos selectores y los radios se pisarian entre si.
  assign grupo = 'a'
  if drawer
    assign grupo = 'drawer'
  endif
-%}

{%- if cart.item_count > 0 and pct > 0 and base > 0 -%}
  <div
    class="pago-contado"
    data-pago-contado
    data-codigo="{{ codigo | escape }}"
    data-attr="{{ attr_key | escape }}"
    data-val-contado="{{ val_contado | escape }}"
    data-val-tarjeta="{{ val_tarjeta | escape }}"
    data-quiere="{% if quiere_contado %}contado{% else %}tarjeta{% endif %}"
    data-aplicado="{% if aplicado %}true{% else %}false{% endif %}"
    data-grupo="pago-contado-{{ grupo }}"
  >
    <p class="pago-contado__titulo">¿Cómo vas a pagar?</p>

    <label class="pago-contado__opcion{% if quiere_contado %} pago-contado__opcion--activa{% endif %}">
      <input type="radio" name="pago-contado-{{ grupo }}" value="contado"{% if quiere_contado %} checked{% endif %}>
      <span class="pago-contado__texto">
        <span class="pago-contado__nombre">Transferencia o efectivo</span>
        <span class="pago-contado__detalle">
          {{ contado | money }} &middot; ahorrás {{ ahorro | money }} ({{ pct }}%)
        </span>
      </span>
    </label>

    <label class="pago-contado__opcion{% unless quiere_contado %} pago-contado__opcion--activa{% endunless %}">
      <input type="radio" name="pago-contado-{{ grupo }}" value="tarjeta"{% unless quiere_contado %} checked{% endunless %}>
      <span class="pago-contado__texto">
        <span class="pago-contado__nombre">Tarjeta, débito o cuotas</span>
        <span class="pago-contado__detalle">{{ base | money }}</span>
      </span>
    </label>

    <p class="pago-contado__nota" data-pago-contado-estado>
      {%- if quiere_contado and aplicado -%}
        Descuento aplicado. Al finalizar la compra, pagá con transferencia o efectivo.
      {%- elsif quiere_contado -%}
        Aplicando el descuento...
      {%- else -%}
        Elegí transferencia o efectivo y el total baja {{ pct }}%.
      {%- endif -%}
    </p>
  </div>

  <script>
    (function () {
      // Delegacion en document, a proposito. El drawer de Shrine se re-renderiza
      // con innerHTML cuando cambia el carrito, y los <script> insertados asi NO
      // se ejecutan: enganchar el listener a cada caja dejaba el selector mudo
      // apenas agregabas un producto. El listener en document sobrevive a
      // cualquier re-render, haya o no corrido este script de nuevo.
      if (window.__precioContadoListo) return;
      window.__precioContadoListo = true;

      var raiz = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      var CLAVE_REINTENTO = 'precio-contado-reintento';
      var CLAVE_ABRIR = 'precio-contado-abrir-drawer';

      function memo(accion, clave, valor) {
        try {
          if (accion === 'get') return window.sessionStorage.getItem(clave);
          if (accion === 'set') window.sessionStorage.setItem(clave, valor);
          if (accion === 'del') window.sessionStorage.removeItem(clave);
        } catch (e) {}
        return null;
      }

      function aplicar(box, contado) {
        var estado = box.querySelector('[data-pago-contado-estado]');
        var attrs = {};
        attrs[box.getAttribute('data-attr')] = contado
          ? box.getAttribute('data-val-contado')
          : box.getAttribute('data-val-tarjeta');

        box.setAttribute('aria-busy', 'true');
        if (estado) estado.textContent = 'Actualizando el total...';

        return fetch(raiz + 'cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            attributes: attrs,
            discount: contado ? box.getAttribute('data-codigo') : ''
          })
        })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function () {
            // La recarga cierra el drawer; dejar marcado que hay que reabrirlo.
            if (box.closest && box.closest('cart-drawer')) {
              memo('set', CLAVE_ABRIR, '1');
            }
            window.location.reload();
          })
          .catch(function () {
            box.removeAttribute('aria-busy');
            if (estado) {
              estado.textContent = 'No pudimos actualizar el total. Recarga la pagina y proba de nuevo.';
            }
          });
      }

      document.addEventListener('change', function (ev) {
        var input = ev.target;
        if (!input || input.type !== 'radio') return;
        if (!input.name || input.name.indexOf('pago-contado-') !== 0) return;
        var box = input.closest ? input.closest('[data-pago-contado]') : null;
        if (!box) return;
        memo('del', CLAVE_REINTENTO);
        aplicar(box, input.value === 'contado');
      });

      function alCargar() {
        if (memo('get', CLAVE_ABRIR)) {
          memo('del', CLAVE_ABRIR);
          var drawer = document.querySelector('cart-drawer');
          if (drawer && typeof drawer.open === 'function') drawer.open();
        }

        var caja = document.querySelector('[data-pago-contado]');
        if (!caja) return;

        var quiereContado = caja.getAttribute('data-quiere') === 'contado';
        var aplicado = caja.getAttribute('data-aplicado') === 'true';

        if (quiereContado && aplicado) {
          memo('del', CLAVE_REINTENTO);
        } else if (quiereContado && !aplicado) {
          // Pidio contado pero el descuento no quedo puesto. Una sola vez por
          // sesion, para no entrar en un bucle de recargas si el codigo no existe.
          if (memo('get', CLAVE_REINTENTO)) {
            var notas = document.querySelectorAll('[data-pago-contado-estado]');
            for (var i = 0; i < notas.length; i++) {
              notas[i].textContent = 'No pudimos aplicar el descuento. Avisanos y lo resolvemos.';
            }
          } else {
            memo('set', CLAVE_REINTENTO, '1');
            aplicar(caja, true);
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', alCargar);
      } else {
        alCargar();
      }
    })();
  </script>
{%- endif -%}
