{%- comment -%}
  precio-contado.liquid - Martinez Motos

  Muestra, debajo del precio de lista, el precio pagando con transferencia o efectivo.

  Parametros (todos opcionales):
    product      - el producto; se usa la variante seleccionada
    variant      - una variante concreta (tiene prioridad sobre product)
    pct_override - sobreescribe el porcentaje para este render
    destacado    - true: recuadro resaltado (ficha de producto)
    compacto     - true: una linea chica (grilla de coleccion)

  Para cambiar el 10%: editar la linea "assign pct = 10" de abajo,
  o crear el theme setting precio_contado_pct (ver README del repo).

  paso_pesos = 0 -> sin redondeo, a proposito: el precio exhibido tiene que ser
  exactamente el que cobra el descuento del checkout (10% justo). Poniendo 10
  redondea a multiplos de $10, pero entonces se exhibe menos de lo que se cobra.

  Para excluir un producto: metafield booleano custom.sin_precio_contado = true
{%- endcomment -%}

{%- liquid
  assign pct = 10
  if settings.precio_contado_pct != blank
    assign pct = settings.precio_contado_pct
  endif
  if pct_override != blank
    assign pct = pct_override
  endif

  assign paso_pesos = 0
  if settings.precio_contado_redondeo != blank
    assign paso_pesos = settings.precio_contado_redondeo
  endif

  assign base = 0
  assign varia = false
  if variant != blank
    assign base = variant.price
  elsif product != blank
    if compacto and product.price_varies
      assign base = product.price_min
      assign varia = true
    else
      assign base = product.selected_or_first_available_variant.price
    endif
  endif

  assign excluido = false
  if product != blank and product.metafields.custom.sin_precio_contado.value == true
    assign excluido = true
  endif
  if product != blank and product.available == false
    assign excluido = true
  endif
-%}

{%- if base > 0 and pct > 0 and excluido == false -%}
  {%- liquid
    assign factor = 100 | minus: pct
    assign exacto = base | times: factor | divided_by: 100 | floor

    assign paso = paso_pesos | times: 100
    assign contado = exacto
    if paso > 0
      assign contado = exacto | divided_by: paso | floor | times: paso
    endif

    assign perdida = exacto | minus: contado
    assign tope = base | divided_by: 100 | floor
    if perdida > tope or contado <= 0
      assign contado = exacto
    endif

    assign monto = contado | money
    if settings.currency_code_enabled
      assign monto = contado | money_with_currency
    endif

    assign leyenda = 'pagando con transferencia o efectivo'
    if settings.precio_contado_texto != blank
      assign leyenda = settings.precio_contado_texto
    endif

    assign clases = 'precio-contado'
    if destacado
      assign clases = clases | append: ' precio-contado--destacado'
    endif
    if compacto
      assign clases = clases | append: ' precio-contado--compacto'
    endif
  -%}
  {{ 'precio-contado.css' | asset_url | stylesheet_tag }}
  <div class="{{ clases }}">
    <span class="precio-contado__monto">{% if varia %}desde {% endif %}{{ monto }}</span>
    <span class="precio-contado__label">
      {%- if compacto -%}
        contado
      {%- else -%}
        {{ leyenda }} &middot; {{ pct }}% OFF
        {%- if settings.precio_contado_link != blank %} <a class="precio-contado__link" href="{{ settings.precio_contado_link }}">Ver como</a>{% endif -%}
      {%- endif -%}
    </span>
  </div>
{%- endif -%}
