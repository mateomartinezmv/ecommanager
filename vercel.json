{
  "functions": {
    "api/importaciones.js": { "maxDuration": 10 },
    "api/clientes.js": { "maxDuration": 10 },
    "api/productos.js": { "maxDuration": 10 },
    "api/ventas.js": { "maxDuration": 10 },
    "api/envios.js": { "maxDuration": 20 },
    "api/direcciones.js": { "maxDuration": 10 },
    "api/transportistas.js": { "maxDuration": 10 },
    "api/meli/auth.js": { "maxDuration": 10 },
    "api/meli/callback.js": { "maxDuration": 10 },
    "api/meli/notify.js": { "maxDuration": 30 },
    "api/meli/preguntas.js": { "maxDuration": 30 },
    "api/meli/importar.js": { "maxDuration": 30 },
    "api/meli/reprocesar.js": { "maxDuration": 30 },
    "api/meli/actualizar-envios.js": { "maxDuration": 60 },
    "api/meli/backfill-envios.js": { "maxDuration": 60 },
    "api/meli/sync-envios.js": { "maxDuration": 60 },
    "api/meli/debug-item.js": { "maxDuration": 15 },
    "api/meli/etiqueta.js": { "maxDuration": 30 },
    "api/shopify/notify.js": { "maxDuration": 10 },
    "api/meli/sync-stock.js": { "maxDuration": 30 },
    "api/shopify/sync-stock.js": { "maxDuration": 30 },
    "api/shopify/productos.js": { "maxDuration": 10 },
    "api/shopify/buscar-sku.js": { "maxDuration": 10 },
    "api/devoluciones.js": { "maxDuration": 10 },
    "api/movimientos.js": { "maxDuration": 10 },
    "api/meli/recalcular-comisiones.js": { "maxDuration": 60 },
    "api/meli/reprocesar-ordenes.js": { "maxDuration": 60 },
    "api/meli/ads.js": { "maxDuration": 30 },
    "api/meli/ads-historico.js": { "maxDuration": 10 },
    "api/meli/ads-campanas.js": { "maxDuration": 30 },
    "api/meli/ads-anuncios.js": { "maxDuration": 60 },
    "api/meli/ads-recomendaciones.js": { "maxDuration": 60 },
    "api/meli/ads-economia.js": { "maxDuration": 30 },
    "api/meli/ads-evolucion.js": { "maxDuration": 15 },
    "api/meli/ads-cambios.js": { "maxDuration": 30 },
    "api/meli/ads-acciones.js": { "maxDuration": 30 },
    "api/meli/vincular-publicacion.js": { "maxDuration": 10 },
    "api/meli/opiniones.js": { "maxDuration": 60 },
    "api/meli/angulos.js": { "maxDuration": 60 },
    "api/meli/diagnostico.js": { "maxDuration": 60 },
    "api/meli/stock.js": { "maxDuration": 60 },
    "api/*/precios.js": { "maxDuration": 60 },
    "api/meli/fotos.js": { "maxDuration": 60 },
    "api/fotos-ia.js": { "maxDuration": 60, "includeFiles": "public/marca/**" },
    "api/telegram/setup.js": { "maxDuration": 15 },
    "api/telegram/webhook.js": { "maxDuration": 30 },
    "api/cron/*.js": { "maxDuration": 60 },
    "api/meta/*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/resumen-diario",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/ads-diario",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/ads-anuncios-diario",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/cron/sync-envios",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/sync-stock-pubs",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/instagram-publicar",
      "schedule": "*/5 * * * *"
    }
  ]
}
